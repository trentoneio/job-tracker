# Build-context hygiene: the image only needs app/, requirements.txt and
# entrypoint.py. Keep live data (personal PDFs!), dev venvs, tests and git
# history out of what Docker ships to its daemon on every build.
.git/
.venv/
data/
tests/
prompts/
PLAN.md
SESSION_LOG.md
__pycache__/
*.pyc
.pytest_cache/
